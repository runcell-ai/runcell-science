SERVER_HOST=127.0.0.1
SERVER_PORT=27184
SQLITE_PATH=apps/server/data/open-science.sqlite
LOG_DIR=logs/server
MIGRATION_DIR=apps/server/src/db/migrations
LOG_LEVEL=info

AGENT_DEFAULT_CWD=/absolute/path/to/workspace
AGENT_DEFAULT_RUNTIME_MODE=full_access

CODEX_BINARY_PATH=codex
CODEX_HOME=
CODEX_DEFAULT_MODEL=
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX=danger-full-access

CLAUDE_CODE_BINARY_PATH=
CLAUDE_CONFIG_DIR=
CLAUDE_DEFAULT_MODEL=
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS=true

GROK_BINARY_PATH=grok
GROK_DEFAULT_MODEL=

OPENCODE_BINARY_PATH=opencode
OPENCODE_DEFAULT_MODEL=
# Optional: connect to an already-running OpenCode server instead of managing one per session.
# Remote URLs must use HTTPS and set a password; loopback HTTP is allowed.
# External servers use their own connector configuration; per-session bundled connector toggles are disabled.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
